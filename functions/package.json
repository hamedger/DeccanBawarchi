{
  "name": "deccan-bawarchi-functions",
  "version": "1.0.0",
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "serve:full": "npm run build && firebase emulators:start --only functions,auth,firestore",
    "serve:auth": "npm run build && firebase emulators:start --only functions,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed": "npm run seed --prefix .."
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.6.0",
    "node-fetch": "^2.7.0",
    "openai": "^4.52.0",
    "stripe": "^16.0.0"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.11",
    "typescript": "^5.4.5"
  },
  "private": true
}
